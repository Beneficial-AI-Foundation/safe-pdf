import SafePdf.Spec.RepairAgreeComp

/-!
# Exact C4 for encrypted files with compressed entries (task 12.7h)

Plan.md §5 (claim C4), §5.4 (the repair path), §6 Phase 12 "Proof gaps"; `docs/safety.md` §5,
gap 1. Joins `Spec.RepairAgreeExt.c4_enc` (12.7c: encrypted files, no compressed entries) and
`Spec.RepairAgreeComp.c4_comp_eq` (12.7f: compressed entries, unencrypted files).

## The Core change this rests on

Repair rule R6 (object-stream members, `Repair.withObjStm`) used to run only inside
`Repair.repair`, on unencrypted repaired trailers: an encrypted file's containers are
encrypted, and the decryption state exists only after `withCrypt`. Since task 12.7h the pass
takes a container pre-pass (`Xref.ObjStm.Pre`), and `Core.Open.repairOpen` runs it a second
time, after `withCrypt`, with the repaired document's own pre-pass `OpenDoc.pre` (rule E4,
`OpenDoc.withObjStmEnc`): an encrypted repaired file gets its object-stream members, decrypted
exactly as `getObject` decrypts containers (rule G5).

**A compressed `/Encrypt` reference.** ISO 32000-2 §7.5.7 forbids the encryption dictionary
inside an object stream (it would be needed to decrypt its own container). Both paths reject
it: strictly, `OpenDoc.encryptDict` fails on a compressed `/Encrypt` entry; on the repair
path `withCrypt` runs on the scanned section, which has no compressed entries, so an
`/Encrypt` object that only exists inside an object stream is not found (`null`, "not a
dictionary") and repair fails with `Error.encryption` (rule E3). R6 never replaces a classic
entry (`Repair.objStmAdds_new`), so the decryption state stays valid after it.

## The hypothesis (`HypEncComp`, decidable)

* H2c, H3, H4 of `HypCompStrip`: every in-use strict entry is the newest scan hit of its
  number (compressed and free entries allowed), every hit has an in-use strict entry, the scan
  is within `limits.maxObjects`.
* `trailerOkEncComp` (H5e + H7f + H8, all on the repair path's output): the repaired trailer
  is **encrypted** and has the strict `/Root`, `/Encrypt` value and first `/ID` string (H5e of
  `HypEnc`); the section after R6 with the strict container pass, `withObjStm … d.pre sec`, has
  exactly the strict compressed entries (H7f of `HypCompEq`) and as many entries as the strict
  section (H8 of `HypCompEq`, equal fuel; task 12.7g may drop it from `c4_comp_eq`, and then
  from here through `getObject_strip`).

## Results

* `callPoint_none_of_obj`, `parseIndirectWith_obj`: a parse whose body is not a stream never
  calls its `/Length` resolver, so it is the same under every lookup.
* `encryptDict_transfer`: the strict encryption dictionary is found the same way on the
  repaired (scanned) section, although the strict section has compressed entries (the
  `/Encrypt` object is in use on both and is a dictionary, not a stream).
* `c4_enc_comp` / `c4_enc_comp_check` (**exact**): the repair path succeeds with the same
  bytes, in-use entries, compressed entries, `/Root`, **decryption state**, and **equal**
  (decrypted) `getObject` for every `num gen`.
* Fixtures (generated by `scripts/gen-enc-objstm.py`, stdlib Python with its own RC4, not
  `Core.Crypt`): `encObjStmBytes` passes `checkEncComp` (and fails `checkEnc`, which forbids
  compressed entries, and `checkCompEq`, which forbids encryption); before 12.7h its objects 2
  and 3 were `null` after repair. 12.7c's `encBytes` (no object stream) passes it too.
  `encOrphanBytes` (the members are free strictly) shows that
  the H7 part of `HypEnc` (task 12.7h) is necessary.
-/

namespace SafePdf.Spec.RepairAgreeEncComp

open SafePdf
open SafePdf.Core.Open
open SafePdf.Core.Xref (XrefEntry XrefSection Trailer)
open SafePdf.Core.Xref.Length
open SafePdf.Spec.RepairAgree
open SafePdf.Spec.RepairAgreeFree
open SafePdf.Spec.RepairAgreeExt
open SafePdf.Spec.RepairAgreeComp
open SafePdf.Repair (scanSection toEntries)

/-! ## Non-stream objects do not read the lookup -/

/-- A parse whose body is not a stream has no length-resolver call point. -/
theorem callPoint_none_of_obj {lenF : Nat → Core.ObjParse.LengthResolver} {limits : Limits}
    {bytes : ByteArray} {pos : Nat} {io : IndirectObject} {r : Nat} {o : PdfObject}
    (h : parseIndirectWith lenF limits bytes pos = .ok (io, r)) (hb : io.body = .obj o) :
    callPoint limits bytes pos = none := by
  unfold parseIndirectWith at h
  unfold callPoint
  rcases hh : Core.ObjParse.parseHeader bytes pos with e | ⟨n, g, q⟩
  · rfl
  · rw [hh] at h
    simp only at h ⊢
    unfold Core.ObjParse.parseIndirectBodyWith at h
    rcases ho : Core.ObjParse.parseObject limits bytes q with e | ⟨o', r'⟩
    · rfl
    · rw [ho] at h
      simp only at h ⊢
      rcases hk : Core.Lex.next bytes r' with e | _ | ⟨t, r2⟩
      · rfl
      · rfl
      · rw [hk] at h
        cases t <;> try rfl
        rename_i k
        simp only at h ⊢
        by_cases h1 : k = Core.ObjParse.kwEndobj
        · simp [h1]
        · by_cases h2 : k = Core.ObjParse.kwStream
          · subst h2
            simp only [h1, ↓reduceIte] at h ⊢
            cases o' <;> try rfl
            rename_i ents
            simp only at h
            rcases hp : Core.ObjParse.parseStreamBodyWith (lenF n.toNat) bytes r2 ents with
              err | ⟨st, r3⟩
            · rw [hp] at h; cases h
            · rw [hp] at h
              simp only [Except.ok.injEq, Prod.mk.injEq] at h
              obtain ⟨rfl, -⟩ := h
              cases hb
          · simp [h1, h2]

/-- **A non-stream object parses the same under every resolver.** -/
theorem parseIndirectWith_obj {lenF : Nat → Core.ObjParse.LengthResolver} {limits : Limits}
    {bytes : ByteArray} {pos : Nat} {io : IndirectObject} {r : Nat} {o : PdfObject}
    (h : parseIndirectWith lenF limits bytes pos = .ok (io, r)) (hb : io.body = .obj o)
    (lenG : Nat → Core.ObjParse.LengthResolver) :
    parseIndirectWith lenG limits bytes pos = .ok (io, r) := by
  rw [← h]
  apply parseIndirectWith_congr
  intro n d p hc
  rw [callPoint_none_of_obj h hb] at hc
  cases hc

/-! ## The decryption state on the repaired section -/

/-- **The strict encryption dictionary is found on the repaired section.** If `e` (no
decryption state) finds its encryption dictionary, then so does any `e'` over the same bytes,
with no decryption state, the same `/Encrypt` value, every in-use entry of `e` and no
entry. (`e` may have compressed entries: `encryptDict` rejects a compressed
`/Encrypt`, and the in-use `/Encrypt` object is a dictionary, whose parse does not read the
lookup, `parseIndirectWith_obj`.) -/
theorem encryptDict_transfer {limits : Limits} {e e' : OpenDoc}
    {r : Dict × Option (Nat × Nat)} (h : e.encryptDict limits = .ok r)
    (hb : e.bytes = e'.bytes) (hc : e.crypt = none) (hc' : e'.crypt = none)
    (hE : Dict.get? e.trailer.dict Core.Xref.nameEncrypt =
      Dict.get? e'.trailer.dict Core.Xref.nameEncrypt)
    (hU : ∀ n off g, e.lookup n = some (.inUse off g) → e'.lookup n = some (.inUse off g)) :
    e'.encryptDict limits = .ok r := by
  unfold OpenDoc.encryptDict at h ⊢
  rw [← hE]
  rcases hv : Dict.get? e.trailer.dict Core.Xref.nameEncrypt with _ | o
  · rw [hv] at h; cases h
  · rw [hv] at h
    cases o
    case ref n g =>
      simp only at h ⊢
      -- the strict entry of `n` is not compressed, and `getObject` returns a dictionary
      rcases hl : e.lookup n with _ | (⟨a, g1⟩ | ⟨off, g1⟩ | ⟨c, i⟩)
      · rw [hl] at h
        simp only [OpenDoc.getObject, OpenDoc.getObjectTrace, hl, nullBody] at h
        cases h
      · rw [hl] at h
        simp only [OpenDoc.getObject, OpenDoc.getObjectTrace, hl, nullBody] at h
        cases h
      · rw [hl] at h
        simp only at h
        have hl' := hU n off g1 hl
        rw [hl']
        simp only
        unfold OpenDoc.getObject OpenDoc.getObjectTrace at h ⊢
        rw [hl] at h
        rw [hl']
        simp only at h ⊢
        by_cases hg : g1 = g
        · simp only [hg, ↓reduceIte] at h ⊢
          rw [parseIndirectResolved_eq_with] at h ⊢
          rcases hp : parseIndirectWith (lengthOf e.pre e.lookup limits e.bytes e.objectCount)
              limits e.bytes off with err | ⟨io, r2⟩
          · rw [hp] at h; cases h
          · rw [hp] at h
            simp only at h
            have hdec : ∀ (d : OpenDoc), d.crypt = none → ∀ a b x,
                d.decrypt a b x = .ok x := fun d hd a b x => decrypt_none hd a b x
            by_cases hio : io.num = n ∧ io.gen = g
            · simp only [hio, and_self, ↓reduceIte, hdec e hc] at h
              rcases hbody : io.body with o | st
              · rw [hbody] at h
                rw [← hb, parseIndirectWith_obj hp hbody]
                simp only [hio, and_self, ↓reduceIte, hdec e' hc', hbody]
                exact h
              · rw [hbody] at h; cases h
            · simp only [hio, ↓reduceIte] at h
              cases h
        · simp only [hg, ↓reduceIte, nullBody] at h
          cases h
      · rw [hl] at h; cases h
    all_goals exact h

/-- **Same decryption state from equal encryption dictionaries** (as
`RepairAgreeExt.withCrypt_congr`, with the encryption dictionaries given). -/
theorem withCrypt_of_encryptDict {limits : Limits} {e e' d : OpenDoc}
    (hen : e.trailer.encrypted = e'.trailer.encrypted)
    (hid : Core.Crypt.id0Of e.trailer.dict = Core.Crypt.id0Of e'.trailer.dict)
    (hed : e.encryptDict limits = e'.encryptDict limits)
    (hc0 : e.crypt = e'.crypt)
    (h : e.withCrypt limits = .ok d) : e'.withCrypt limits = .ok { e' with crypt := d.crypt } := by
  unfold OpenDoc.withCrypt at h ⊢
  rw [← hen]
  split at h
  · rw [← hed]
    split at h
    · cases h
    · rename_i enc ref _
      have hs : Core.Crypt.setup enc e.trailer.dict ref =
          Core.Crypt.setup enc e'.trailer.dict ref := by
        unfold Core.Crypt.setup; rw [hid]
      split at h
      · cases h
      · rename_i st hst
        cases h
        simp only [← hs, hst, ‹e.trailer.encrypted = true›, ↓reduceIte]
  · rename_i hne
    cases h
    simp only [hne, Bool.false_eq_true, ↓reduceIte, hc0]

/-- A successful `withCrypt` on an encrypted trailer finds the encryption dictionary and sets
a decryption state. -/
theorem withCrypt_enc {limits : Limits} {e d : OpenDoc} (h : e.withCrypt limits = .ok d)
    (he : e.trailer.encrypted = true) :
    (∃ r, e.encryptDict limits = .ok r) ∧ ∃ st, d.crypt = some st := by
  unfold OpenDoc.withCrypt at h
  simp only [he, ↓reduceIte] at h
  split at h
  · cases h
  · rename_i r _
    split at h
    · cases h
    · rename_i st _
      cases h
      exact ⟨⟨_, ‹_›⟩, st, rfl⟩

/-! ## The hypothesis -/

/-- Conditions H5e, H7f and H8 for an encrypted file (task 12.7h): the repair path's trailer
exists, is encrypted (as the strict one) and has the strict `/Root`, `/Encrypt` value and first
`/ID` string; after rule R6 with the strict container pass (`withObjStm … d.pre`, what
`OpenDoc.withObjStmEnc` runs once the repaired state equals the strict one), every compressed
entry is the strict entry of its number, every strict compressed entry is there, and the
section has as many entries as the strict one (equal fuel). -/
def trailerOkEncComp (limits : Limits) (bytes : ByteArray) (d : OpenDoc) : Bool :=
  match Repair.repair limits bytes with
  | .ok (sec, tr) =>
    let sec' := Repair.withObjStm limits bytes d.pre sec
    tr.encrypted && d.trailer.encrypted && decide (tr.root? = d.trailer.root?) &&
      decide (Dict.get? tr.dict Core.Xref.nameEncrypt =
        Dict.get? d.trailer.dict Core.Xref.nameEncrypt) &&
      decide ((Core.Crypt.id0Of tr.dict).data = (Core.Crypt.id0Of d.trailer.dict).data) &&
      sec'.entries.all (fun x => !isComp x.2 || d.lookup x.1 == some x.2) &&
      d.xref.entries.all (fun x =>
        !isComp x.2 || (OpenDoc.mk' bytes sec' tr 0 true).lookup x.1 == some x.2) &&
      sec'.entries.length == d.xref.entries.length
  | .error _ => false

/-- **The hypothesis of exact C4 for encrypted files with compressed entries**: H2c, H3, H4
(as in `HypCompStrip`) and `trailerOkEncComp`. -/
def HypEncComp (limits : Limits) (bytes : ByteArray) (d : OpenDoc) : Prop :=
  (∀ x ∈ d.xref.entries, EntryOkComp (hits limits bytes) x) ∧
  (∀ x ∈ hits limits bytes, ∃ e ∈ d.xref.entries, e.1 = x.1 ∧ isInUse e.2 = true) ∧
  (newestHits (hits limits bytes)).length ≤ limits.maxObjects ∧
  trailerOkEncComp limits bytes d = true

/-- `HypEncComp` is decidable. -/
instance instDecidableHypEncComp (limits : Limits) (bytes : ByteArray) (d : OpenDoc) :
    Decidable (HypEncComp limits bytes d) := by
  unfold HypEncComp; infer_instance

/-- **The checker**: the strict path succeeds and its document satisfies `HypEncComp`. -/
def checkEncComp (limits : Limits) (bytes : ByteArray) : Bool :=
  match strictOpen limits bytes with
  | .ok d => decide (HypEncComp limits bytes d)
  | .error _ => false

/-! ## Exact C4 -/

/-- **C4 for encrypted files with compressed entries, exact form (repair conservativity; task
12.7h).** If the strict path opens `bytes` as `d` and `HypEncComp limits bytes d` holds, the
repair path also succeeds; its document is flagged `repaired`, has the same bytes, the same
in-use entries, the **same compressed entries** (found by rule R6 after `withCrypt`), the same
`/Root` and the **same decryption state** as `d`, and for **every** `num gen` its (decrypted)
`getObject` is **equal** to `d`'s. -/
theorem c4_enc_comp {limits : Limits} {bytes : ByteArray} {d : OpenDoc}
    (hs : strictOpen limits bytes = .ok d) (hh : HypEncComp limits bytes d) :
    ∃ d', repairOpen limits bytes = .ok d' ∧ d'.repaired = true ∧ d'.bytes = d.bytes ∧
      (∀ n off g, d'.lookup n = some (.inUse off g) ↔ d.lookup n = some (.inUse off g)) ∧
      (∀ n c i, d'.lookup n = some (.compressed c i) ↔ d.lookup n = some (.compressed c i)) ∧
      d'.trailer.root? = d.trailer.root? ∧ d'.crypt = d.crypt ∧
      ∀ num gen, d'.getObject limits num gen = d.getObject limits num gen := by
  obtain ⟨hent, hcov, hcap, htr⟩ := hh
  have hbytes := strictOpen_bytes hs
  obtain ⟨-, -, -, -, hval⟩ := strictOpen_ok hs
  obtain ⟨sec0, tr0, k, hwc⟩ := strictOpen_pre hs
  obtain ⟨c, hd⟩ := withCrypt_ok hwc
  let e := OpenDoc.mk' bytes sec0 tr0 k false
  have hex : e.xref = d.xref := by rw [hd]
  have het : e.trailer = d.trailer := by rw [hd]
  have hin : ∀ n off g, (n, XrefEntry.inUse off g) ∈ d.xref.entries ↔
      (n, XrefEntry.inUse off g) ∈ (scanSection limits bytes).entries :=
    inUse_mem_iff_of (fun n off g hx => hent _ hx) hcov hcap
  unfold trailerOkEncComp at htr
  split at htr
  · rename_i sec tr hrep
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at htr
    obtain ⟨⟨⟨⟨⟨⟨⟨htre, hde⟩, hroot⟩, hE⟩, hid⟩, hcomp⟩, hcomp2⟩, hlen⟩ := htr
    have hsec := Repair.repair_encrypted hrep htre
    subst hsec
    let e' := OpenDoc.mk' bytes (scanSection limits bytes) tr 0 true
    -- the strict state is found on the scanned section
    have hee : e.trailer.encrypted = true := by rw [het]; exact hde
    obtain ⟨⟨r, her⟩, st, hst⟩ := withCrypt_enc hwc hee
    have hl1 : ∀ m x, d.lookup m = some x ↔ (m, x) ∈ d.xref.entries := fun m x => by
      rw [WritePrefix.lookup_eq d, Unambiguous.lookupEntry_eq_some_iff d.xref.keys_nodup]
    have hle : ∀ m x, e.lookup m = some x ↔ (m, x) ∈ d.xref.entries := fun m x => by
      rw [WritePrefix.lookup_eq e, Unambiguous.lookupEntry_eq_some_iff e.xref.keys_nodup, hex]
    have hle' : ∀ m x, e'.lookup m = some x ↔ (m, x) ∈ (scanSection limits bytes).entries :=
      fun m x => by
        rw [WritePrefix.lookup_eq e']
        exact Unambiguous.lookupEntry_eq_some_iff (scanSection limits bytes).keys_nodup
    have her' : e'.encryptDict limits = .ok r :=
      encryptDict_transfer her rfl rfl rfl (by rw [het]; exact hE.symm)
        (fun n off g h => (hle' _ _).mpr ((hin n off g).mp ((hle _ _).mp h)))
    have hwc' : e'.withCrypt limits = .ok { e' with crypt := d.crypt } :=
      withCrypt_of_encryptDict (by rw [het]; exact (hde.trans htre.symm))
        (by rw [het]; exact (byteArray_eq_of_data hid).symm) (her.trans her'.symm) rfl hwc
    -- rule E4: R6 with the strict container pass
    let d1 : OpenDoc := { e' with crypt := d.crypt }
    let d' : OpenDoc := d1.withObjStmEnc limits
    obtain ⟨hb', hrp', -, hc', -, hro', -⟩ := withObjStmEnc_fields d1 limits
    let sec' := Repair.withObjStm limits bytes d.pre (scanSection limits bytes)
    have hx' : d'.xref = sec' := by
      show (d1.withObjStmEnc limits).xref = _
      rw [withObjStmEnc_xref]
      have hcs : d1.crypt.isSome = true := by show d.crypt.isSome = true; rw [hst]; rfl
      have hpre : d1.pre = d.pre := by unfold OpenDoc.pre; rfl
      simp only [hcs, ↓reduceIte, hpre]
      rfl
    have hl2 : ∀ m x, d'.lookup m = some x ↔ (m, x) ∈ sec'.entries := fun m x => by
      rw [WritePrefix.lookup_eq d', Unambiguous.lookupEntry_eq_some_iff d'.xref.keys_nodup, hx']
    have hl3 : ∀ m x, (OpenDoc.mk' bytes sec' tr 0 true).lookup m = some x ↔
        (m, x) ∈ sec'.entries := fun m x => by
      rw [WritePrefix.lookup_eq (OpenDoc.mk' bytes sec' tr 0 true)]
      exact Unambiguous.lookupEntry_eq_some_iff sec'.keys_nodup
    have hinS : ∀ n off g, (n, XrefEntry.inUse off g) ∈ sec'.entries ↔
        (n, XrefEntry.inUse off g) ∈ (scanSection limits bytes).entries := by
      intro n off g
      obtain ⟨hsup, hsub⟩ := Repair.withObjStm_entries (limits := limits) (bytes := bytes)
        (pre := d.pre) (base := scanSection limits bytes)
      constructor
      · intro h
        rcases hsub _ h with h | ⟨c, i, hc⟩
        · exact h
        · cases hc
      · exact hsup _
    have hU : ∀ n off g, d'.lookup n = some (.inUse off g) ↔ d.lookup n = some (.inUse off g) :=
      fun n off g => by rw [hl2, hl1, hinS, hin]
    have hC : ∀ n c i, d'.lookup n = some (.compressed c i) ↔
        d.lookup n = some (.compressed c i) := by
      intro n c i
      constructor
      · intro h
        have := List.all_eq_true.mp hcomp _ ((hl2 _ _).mp h)
        simpa [isComp] using this
      · intro h
        have := List.all_eq_true.mp hcomp2 _ ((hl1 _ _).mp h)
        simp only [isComp, Bool.not_true, Bool.false_or, beq_iff_eq] at this
        exact (hl2 _ _).mpr ((hl3 _ _).mp this)
    have hf : d.objectCount = d'.objectCount := by
      simp only [OpenDoc.objectCount, d.index_eq, d'.index_eq, List.size_toArray, hx']
      exact hlen.symm
    have hg : ∀ num gen, d'.getObject limits num gen = d.getObject limits num gen :=
      fun num gen => (getObject_strip (d := d) (d' := d') (by rw [hbytes, hb']; rfl)
        (show d.crypt = d'.crypt from hc'.symm)
        (strip_of (fun n off g => (hU n off g).symm) (fun n c i => (hC n c i).symm)) hf
        limits num gen).symm
    have hv : validate limits d' = .ok d' :=
      validate_congr (hroot.symm.trans hro'.symm) (fun n g => (hg n g).symm) hval
    refine ⟨d', ?_, hrp', by rw [hb', hbytes]; rfl, hU, hC, hro'.trans hroot, hc', hg⟩
    unfold repairOpen
    rw [hrep]
    simp only
    rw [hwc']
    exact hv
  · cases htr

/-- **Exact C4 for encrypted files with compressed entries, from the checker.** -/
theorem c4_enc_comp_check {limits : Limits} {bytes : ByteArray}
    (hc : checkEncComp limits bytes = true) :
    ∃ d d', strictOpen limits bytes = .ok d ∧ repairOpen limits bytes = .ok d' ∧
      d'.repaired = true ∧ d'.bytes = d.bytes ∧
      (∀ n off g, d'.lookup n = some (.inUse off g) ↔ d.lookup n = some (.inUse off g)) ∧
      (∀ n c i, d'.lookup n = some (.compressed c i) ↔ d.lookup n = some (.compressed c i)) ∧
      d'.trailer.root? = d.trailer.root? ∧ d'.crypt = d.crypt ∧
      ∀ num gen, d'.getObject limits num gen = d.getObject limits num gen := by
  unfold checkEncComp at hc
  split at hc
  · rename_i d hs
    obtain ⟨d', h⟩ := c4_enc_comp hs (of_decide_eq_true hc)
    exact ⟨d, d', hs, h⟩
  · cases hc

