/-- Test helper: a string entry `key` of the dictionary object `num` on the strict and on the
repair path. -/
def strs (bytes : ByteArray) (num : Nat) (key : String) : Option (List UInt8 × List UInt8) :=
  let get : Except Error IndirectBody → List UInt8 := fun r =>
    match r with
    | .ok (.obj (.dict d)) =>
      match Dict.get? d (Name.ofString key) with
      | some (.string s) => s
      | _ => []
    | _ => []
  match strictOpen Limits.default bytes, repairOpen Limits.default bytes with
  | .ok d, .ok d' => some (get (d.getObject Limits.default num 0),
      get (d'.getObject Limits.default num 0))
  | _, _ => none

/-- Test helper: whether object `num` is a dictionary on the strict and on the repair path. -/
def dicts (bytes : ByteArray) (num : Nat) : Option (Bool × Bool) :=
  let isD : Except Error IndirectBody → Bool := fun r =>
    match r with
    | .ok (.obj (.dict _)) => true
    | _ => false
  match strictOpen Limits.default bytes, repairOpen Limits.default bytes with
  | .ok d, .ok d' => some (isD (d.getObject Limits.default num 0),
      isD (d'.getObject Limits.default num 0))
  | _, _ => none

/-- Test helper: the entries of objects 2 and 3 of the repaired document, and whether both
paths have a decryption state. -/
def repairedLookup (bytes : ByteArray) : Option (Option XrefEntry × Option XrefEntry × Bool) :=
  match strictOpen Limits.default bytes, repairOpen Limits.default bytes with
  | .ok d, .ok d' => some (d'.lookup 2, d'.lookup 3, d.crypt.isSome && d'.crypt.isSome)
  | _, _ => none

-- The object-stream file opens strictly with 2, 3 compressed; the repair path decrypts the
-- container (rule E4) and gets the same compressed entries, with a decryption state.
#guard (match strictOpen Limits.default encObjStmBytes with
  | .ok d => d.lookup 2 == some (.compressed 6 0) && d.lookup 3 == some (.compressed 6 1)
  | .error _ => false)
#guard repairedLookup encObjStmBytes == some (some (.compressed 6 0), some (.compressed 6 1), true)
-- `Repair.repair` alone (before `withCrypt`) adds no compressed entry: R6 is deferred.
#guard (match Repair.repair Limits.default encObjStmBytes with
  | .ok (sec, tr) => tr.encrypted && noComp sec.entries
  | .error _ => false)
-- `c4_enc_comp_check` applies; the earlier checkers do not (compressed entries; encryption).
#guard checkEncComp Limits.default encObjStmBytes = true
#guard checkEnc Limits.default encObjStmBytes = false
#guard checkCompEq Limits.default encObjStmBytes = false
-- Decryption is effective and equal: `/Lang` decrypts to `en-US`; the member's `/Kind` is
-- read in the clear from the decrypted container (not decrypted twice); every object agrees.
#guard strs encObjStmBytes 1 "Lang" = some ("en-US".toUTF8.toList, "en-US".toUTF8.toList)
#guard strs encObjStmBytes 3 "Kind" = some ("member".toUTF8.toList, "member".toUTF8.toList)
#guard dicts encObjStmBytes 2 = some (true, true)
#guard (List.range 9).all (sameObj encObjStmBytes)
-- The orphan variant: strict `null`, repaired dictionaries. `HypEnc`'s H7 part (task 12.7h)
-- rejects it, and so does `HypEncComp` (H7f): the conclusion of `c4_enc` fails here.
#guard dicts encOrphanBytes 2 = some (false, true)
#guard dicts encOrphanBytes 3 = some (false, true)
#guard checkEnc Limits.default encOrphanBytes = false
#guard checkEncComp Limits.default encOrphanBytes = false
-- 12.7c's RC4 file (no object stream) passes both `checkEnc` and `checkEncComp`; 12.7f's
-- unencrypted object-stream file passes `checkCompEq` only (`HypEncComp` asks for encryption).
#guard checkEnc Limits.default encBytes = true
#guard checkEncComp Limits.default encBytes = true
#guard checkCompEq Limits.default objStmBytes = true
#guard checkEncComp Limits.default objStmBytes = false

end SafePdf.Spec.RepairAgreeEncComp
