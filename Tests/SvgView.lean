import SafePdf
import SafePdf.Shell.Views.Svg
import Tests.Golden

/-!
# Golden tests of the `ops` and `svg` inspector views (task 5.4)

Each input under `Tests/golden/svg/` (tiny PDFs generated by `Tests/golden/generate_svg.py`:
rectangles, strokes, colours, `q`/`Q`, `cm`, clips and placeholders; a text page) is rendered
with the deterministic text and JSON forms of the `ops` view (no timings), a consistency line,
and the SVG of every page, in sections separated by `--- <name>` lines, and compared with
`<input>.expected` by `Tests.Golden.runCase` (Plan.md §6 Phase 5, M5 "inspector exports pages
as SVG rendered from the DisplayList"). `SAFEPDF_GOLDEN_UPDATE=1` regenerates;
`python3 -I Tests/golden/generate_svg.py --check Tests/golden/svg` checks that every SVG
section is well-formed XML.

**Consistency.** The views attribute operators by folding `Interp.exec` themselves; the
`--- consistency` line compares their item count, warnings and unsupported count with
`Core.Content.interpBytes` on the same concatenated contents (`ok` or the mismatch).
-/

namespace SafePdf.Tests.SvgView

open SafePdf.Shell.Views.Svg

/-- Directory of the inputs. -/
def dir : System.FilePath := Tests.Golden.goldenRoot / "svg"

/-- Compare the attributed fold with `interpBytes` on one page's contents. -/
def consistency (limits : Limits) (doc : SafePdf.Core.Doc.Doc) (po : PageOps) : String :=
  match doc.pages[po.index]? with
  | none => "no page"
  | some page =>
    match (doc.decodeContentsB limits (SafePdf.Core.Filter.Budget.init limits) page).1 with
    | .error _ => if po.error.isSome then "ok" else "decode mismatch"
    | .ok parts =>
      let r := SafePdf.Core.Content.interpBytes (interpConfig limits) (joinParts parts)
      if r.items.size == po.itemCount && r.warnings == po.interpWarnings + po.tokWarnings &&
          r.unsupported == po.unsupported then "ok"
      else s!"MISMATCH items {r.items.size}/{po.itemCount} warnings {r.warnings}/{po.interpWarnings + po.tokWarnings} unsupported {r.unsupported}/{po.unsupported}"

/-- Render one input (the path is shown as `input`). -/
def render (bytes : ByteArray) : String :=
  let l := Limits.default
  let r := SafePdf.parseWith l bytes
  match SafePdf.Shell.Views.Pages.docOf l r with
  | .error e => s!"error: {SafePdf.Shell.renderError e}\n"
  | .ok doc =>
    let pages := analyzeDoc l doc true
    let lines :=
      ["--- ops"] ++ opsText "input" l r pages none ++
      ["--- ops --json"] ++ opsJson "input" l r pages none ++
      ["--- consistency"] ++ pages.toList.map (fun p => s!"page {p.index}: {consistency l doc p}")
    let svgs := pages.toList.filterMap fun p =>
      doc.pages[p.index]?.map fun page =>
        s!"--- svg page {p.index + 1}\n" ++ renderPage page p.index p
    "\n".intercalate lines ++ "\n" ++ String.join svgs

/-- Run the suite; returns the number of failures. -/
def run : IO Nat := do
  let update := (← IO.getEnv Tests.Golden.updateEnvVar) == some "1"
  if !(← dir.isDir) then
    IO.println s!"  FAIL svg view: directory {dir} not found (run from the repo root)"
    return 1
  let inputs := ((← dir.readDir).map (·.path)).toList.filter Tests.Golden.isInput
  let inputs := inputs.toArray.qsort (fun a b => a.toString < b.toString)
  if inputs.isEmpty then
    IO.println s!"  FAIL svg view: no input files in {dir}"
    return 1
  let mut c : Tests.Golden.Counts := {}
  for input in inputs do
    c ← Tests.Golden.runCase update render input c
  if update then IO.println s!"  svg view: wrote {c.written} .expected file(s)"
  else IO.println s!"  svg view: {c.cases} case(s), {c.failures} failure(s)"
  return c.failures

end SafePdf.Tests.SvgView
