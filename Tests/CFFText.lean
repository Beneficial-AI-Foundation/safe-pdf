import SafePdf

/-!
# CFF fonts in text extraction (task 6.2b)

Plan.md §6 Phase 6 (text extraction, exit M6). Hand-built PDFs embedding the CFF fixtures of
task 6.2 (`Tests/fonts/tiny.cff`, `Tests/fonts/tiny-cid.cff`, generated by
`Tests/fonts/gen_cff.py`) as `/FontFile3` (ASCIIHex-encoded streams):

* a simple `/Type1` font with `/FontFile3 /Subtype /Type1C`, **no `/Widths` and no
  `/ToUnicode`**: widths come from the CFF charstrings, text from the CFF's built-in encoding
  and charset (glyph names through the AGL); with `/Differences` over the built-in encoding;
* a Type0 `Identity-H` font whose `/CIDFontType0` descendant embeds `/FontFile3 /Subtype
  /CIDFontType0C` and has **no `/W`**: widths per CID from the CFF (CID → GID through the
  charset, two Font DICTs with different matrices); `/DW` and `/W` still take precedence.

Each case checks glyph texts, origins (x in thousandths) and the page text.
-/

namespace SafePdf.Tests.CFFText

open SafePdf.Core
open SafePdf.Core.Text

/-- A PDF whose objects `1 …` are the given bodies. -/
def mkPdf (objs : List String) : ByteArray := Id.run do
  let mut body := "%PDF-1.4\n"
  let mut offs : List Nat := []
  let mut i := 1
  for o in objs do
    offs := offs ++ [body.utf8ByteSize]
    body := body ++ s!"{i} 0 obj\n{o}\nendobj\n"
    i := i + 1
  let row (o : Nat) : String :=
    let s := toString o
    String.ofList (List.replicate (10 - s.length) '0') ++ s ++ " 00000 n \n"
  let x := body.utf8ByteSize
  let rows := String.join (offs.map row)
  (body ++ s!"xref\n0 {objs.length + 1}\n0000000000 65535 f \n" ++ rows ++
    s!"trailer\n<< /Size {objs.length + 1} /Root 1 0 R >>\nstartxref\n{x}\n%%EOF\n").toUTF8

/-- A stream object body. -/
def strmObj (d data : String) : String :=
  s!"<< {d} /Length {data.utf8ByteSize} >>\nstream\n{data}\nendstream"

/-- Lower-case hex of a byte array, with the ASCIIHex end marker. -/
def hex (b : ByteArray) : String :=
  let digit (n : Nat) : Char := if n < 10 then Char.ofNat (48 + n) else Char.ofNat (87 + n)
  String.ofList (b.toList.flatMap fun x => [digit (x.toNat / 16), digit (x.toNat % 16)]) ++ ">"

/-- One page showing `c` with font `/F1` = object 5 (`font`); further objects from 6 on. -/
def doc (font c : String) (extra : List String) : ByteArray := mkPdf ([
  "<< /Type /Catalog /Pages 2 0 R >>",
  "<< /Type /Pages /Kids [3 0 R] /Count 1 /MediaBox [0 0 612 792] >>",
  "<< /Type /Page /Parent 2 0 R /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>",
  strmObj "" c,
  font] ++ extra)

/-- A simple Type1C font (`enc`: extra font dictionary entries); 6 descriptor, 7 program. -/
def simpleDoc (cff : ByteArray) (enc c : String) : ByteArray :=
  doc ("<< /Type /Font /Subtype /Type1 /BaseFont /SafePdfTinyCFF /FontDescriptor 6 0 R " ++
      enc ++ " >>") c
    [ "<< /Type /FontDescriptor /FontName /SafePdfTinyCFF /Flags 4 /FontFile3 7 0 R >>",
      strmObj "/Subtype /Type1C /Filter /ASCIIHexDecode" (hex cff) ]

/-- A Type0 Identity-H font over a CIDFontType0C program (`w`: extra CIDFont entries);
6 CIDFont, 7 descriptor, 8 program, 9 ToUnicode. -/
def cidDoc (cff : ByteArray) (w c : String) : ByteArray :=
  doc ("<< /Type /Font /Subtype /Type0 /BaseFont /SafePdfTinyCID /Encoding /Identity-H " ++
      "/DescendantFonts [6 0 R] /ToUnicode 9 0 R >>") c
    [ "<< /Type /Font /Subtype /CIDFontType0 /BaseFont /SafePdfTinyCID " ++
        "/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> " ++
        "/FontDescriptor 7 0 R " ++ w ++ " >>",
      "<< /Type /FontDescriptor /FontName /SafePdfTinyCID /Flags 4 /FontFile3 8 0 R >>",
      strmObj "/Subtype /CIDFontType0C /Filter /ASCIIHexDecode" (hex cff),
      strmObj "" ("1 begincodespacerange <0000> <FFFF> endcodespacerange\n" ++
        "4 beginbfchar <0001> <0057> <0064> <0058> <0065> <0059> <0002> <005A> endbfchar") ]

/-- Extract page 1: glyphs as `(text, x·1000)`, the page text, and the font descriptions. -/
def extract (b : ByteArray) : Option (List (String × Int) × String × List String) :=
  match Doc.openDoc {} b with
  | .ok d =>
    match d.pages.toList with
    | p :: _ =>
      match (extractDocPage {} d p (Filter.Budget.init {})).1 with
      | .ok t => some (t.glyphs.map (fun g => (g.text, g.x.raw / 1000)), t.text,
          t.fonts.map (·.2.desc))
      | .error _ => none
    | [] => none
  | .error _ => none

/-- The cases over the two fixtures: label, PDF, expected glyphs, expected text. -/
def cases (cff cid : ByteArray) : List (String × ByteArray × List (String × Int) × String) :=
  -- tiny.cff widths: space 250, A 650, B 700, C 610, foo 600.5; code 97 is glyph A (encoding
  -- supplement), so its text is "A"
  [ ("Type1C, no /Widths, no ToUnicode", simpleDoc cff "" "BT /F1 10 Tf 72 700 Td (AB Ca) Tj ET",
      [("A", 72000), ("B", 78500), (" ", 85500), ("C", 88000), ("A", 94100)], "AB CA"),
    -- `foo` is not in the AGL: code 102 falls back to ASCII `f`; width 600.5
    ("Type1C, glyph without AGL name", simpleDoc cff "" "BT /F1 10 Tf 72 700 Td (fA) Tj ET",
      [("f", 72000), ("A", 78005)], "fA"),
    ("Type1C, /Differences over the built-in encoding",
      simpleDoc cff "/Encoding << /Differences [65 /B 66 /C] >>"
        "BT /F1 10 Tf 72 700 Td (ABC) Tj ET",
      [("B", 72000), ("C", 79000), ("C", 85100)], "BCC"),
    ("Type1C, /Widths take precedence",
      simpleDoc cff "/FirstChar 65 /LastChar 66 /Widths [1000 1000]"
        "BT /F1 10 Tf 72 700 Td (AB) Tj ET",
      [("A", 72000), ("B", 82000)], "AB"),
    -- tiny-cid.cff advances: CID 0 → 1, 1 → 0.5, 100 → 0.5 (FD 1 matrix), 101 → 0.6;
    -- CID 2 is not in the font: default 1000
    ("CIDFontType0C, no /W, no /DW",
      cidDoc cid "" "BT /F1 10 Tf 72 700 Td <0001006400650002> Tj ET",
      [("W", 72000), ("X", 77000), ("Y", 82000), ("Z", 88000)], "WXYZ"),
    ("CIDFontType0C, /DW wins", cidDoc cid "/DW 800"
        "BT /F1 10 Tf 72 700 Td <0001006400650002> Tj ET",
      [("W", 72000), ("X", 80000), ("Y", 88000), ("Z", 96000)], "WXYZ"),
    ("CIDFontType0C, /W first, then CFF", cidDoc cid "/W [100 [300]]"
        "BT /F1 10 Tf 72 700 Td <0001006400650002> Tj ET",
      [("W", 72000), ("X", 77000), ("Y", 80000), ("Z", 86000)], "WXYZ") ]

/-- Run the cases; the number of failures. -/
def run : IO Nat := do
  let cff ← IO.FS.readBinFile "Tests/fonts/tiny.cff"
  let cid ← IO.FS.readBinFile "Tests/fonts/tiny-cid.cff"
  let mut bad := 0
  for (label, pdf, glyphs, text) in cases cff cid do
    match extract pdf with
    | some (gs, t, descs) =>
      -- the program is read unless `/DW` makes it unnecessary
      let wantProg := (label.splitOn "/DW wins").length == 1
      let hasProg := descs.any fun d => (d.splitOn "FontFile3").length > 1
      if gs != glyphs || t != text || hasProg != wantProg then
        IO.println s!"  FAIL {label}: got {gs} {repr t} {descs}, expected {glyphs} {repr text}"
        bad := bad + 1
    | none =>
      IO.println s!"  FAIL {label}: extraction failed"
      bad := bad + 1
  return bad

end SafePdf.Tests.CFFText
