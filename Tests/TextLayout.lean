import SafePdf

/-!
# Layout gaps of text extraction (task 6.7c)

Plan.md §6 Phase 6 (positioned glyph runs; reading-order heuristic tested, not proven).
Hand-built PDFs:

* **TrueType widths.** The TrueType fixture of task 6.1 (`Tests/fonts/tiny.ttf`, generated by
  `Tests/fonts/gen_truetype.py`; advances gid 0 → 500, 1 → 250, 2 → 600, 3 and 4 → 600, units
  per em 1000) embedded as `/FontFile2` (ASCIIHex-encoded stream):
  * a Type0 `Identity-H` font over a `/CIDFontType2` descendant without `/W` and `/DW`: CID →
    GID through `/CIDToGIDMap /Identity` and through a `/CIDToGIDMap` stream, a CID outside the
    map or the font taking the default 1000; `/W` and `/DW` still take precedence;
  * a simple `/TrueType` font without `/Widths` (non-symbolic: the code's glyph through the
    standard encoding and the Unicode cmap; symbolic: the `(3,0)` `0xF0xx` range), also under a
    standard 14 `/BaseFont` (the program wins over the AFM metrics), and with `/Widths` whose
    range misses a code (that code takes the program's advance).
* **Sub/superscripts.** Helvetica lines with a raised footnote marker (by `Ts` and by `Td`), a
  subscript, a marker starting a footnote line, a superscript on the second of two close lines,
  stacked sub/superscripts, and a far-away raised glyph that must not join; the expected texts
  are MuPDF's (`mutool draw -F txt`) except for the stacked case (see `layoutCases`).

Each case checks glyph texts and origins (x in thousandths) or the page text.
-/

namespace SafePdf.Tests.TextLayout

open SafePdf.Core
open SafePdf.Core.Text

/-- A PDF whose objects `1 …` are the given bodies. -/
def mkPdf (objs : List String) : ByteArray := Id.run do
  let mut body := "%PDF-1.4\n"
  let mut offs : List Nat := []
  let mut i := 1
  for o in objs do
    offs := offs ++ [body.utf8ByteSize]
    body := body ++ s!"{i} 0 obj\n{o}\nendobj\n"
    i := i + 1
  let row (o : Nat) : String :=
    let s := toString o
    String.ofList (List.replicate (10 - s.length) '0') ++ s ++ " 00000 n \n"
  let x := body.utf8ByteSize
  let rows := String.join (offs.map row)
  (body ++ s!"xref\n0 {objs.length + 1}\n0000000000 65535 f \n" ++ rows ++
    s!"trailer\n<< /Size {objs.length + 1} /Root 1 0 R >>\nstartxref\n{x}\n%%EOF\n").toUTF8

/-- A stream object body. -/
def strmObj (d data : String) : String :=
  s!"<< {d} /Length {data.utf8ByteSize} >>\nstream\n{data}\nendstream"

/-- Lower-case hex of a byte array, with the ASCIIHex end marker. -/
def hex (b : ByteArray) : String :=
  let digit (n : Nat) : Char := if n < 10 then Char.ofNat (48 + n) else Char.ofNat (87 + n)
  String.ofList (b.toList.flatMap fun x => [digit (x.toNat / 16), digit (x.toNat % 16)]) ++ ">"

/-- One page showing `c` with font `/F1` = object 5 (`font`); further objects from 6 on. -/
def doc (font c : String) (extra : List String) : ByteArray := mkPdf ([
  "<< /Type /Catalog /Pages 2 0 R >>",
  "<< /Type /Pages /Kids [3 0 R] /Count 1 /MediaBox [0 0 612 792] >>",
  "<< /Type /Page /Parent 2 0 R /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>",
  strmObj "" c,
  font] ++ extra)

/-- A Type0 Identity-H font over a `/CIDFontType2` with the TrueType program (`w`: extra
CIDFont entries, e.g. `/CIDToGIDMap 10 0 R`); 6 CIDFont, 7 descriptor, 8 program, 9 ToUnicode,
10 `map` (a CIDToGIDMap stream body in hex, when given). -/
def cidDoc (ttf : ByteArray) (w c : String) (map : String := "") : ByteArray :=
  doc ("<< /Type /Font /Subtype /Type0 /BaseFont /SafePdfTinyTT /Encoding /Identity-H " ++
      "/DescendantFonts [6 0 R] /ToUnicode 9 0 R >>") c
    ([ "<< /Type /Font /Subtype /CIDFontType2 /BaseFont /SafePdfTinyTT " ++
        "/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> " ++
        "/FontDescriptor 7 0 R " ++ w ++ " >>",
      "<< /Type /FontDescriptor /FontName /SafePdfTinyTT /Flags 4 /FontFile2 8 0 R >>",
      strmObj "/Filter /ASCIIHexDecode" (hex ttf),
      strmObj "" ("1 begincodespacerange <0000> <FFFF> endcodespacerange\n" ++
        "1 beginbfrange <0000> <0009> <0041> endbfrange") ] ++
      (if map.isEmpty then [] else [strmObj "/Filter /ASCIIHexDecode" (map ++ ">")]))

/-- A simple `/TrueType` font over the program (`base`: `/BaseFont`, `flags`: descriptor
`/Flags`, `extra`: further font entries); 6 descriptor, 7 program. -/
def simpleDoc (ttf : ByteArray) (base : String) (flags : Nat) (extra c : String) : ByteArray :=
  doc ("<< /Type /Font /Subtype /TrueType /BaseFont /" ++ base ++ " /FontDescriptor 6 0 R " ++
      extra ++ " >>") c
    [ s!"<< /Type /FontDescriptor /FontName /{base} /Flags {flags} /FontFile2 7 0 R >>",
      strmObj "/Filter /ASCIIHexDecode" (hex ttf) ]

/-- Extract page 1: glyphs as `(text, x·1000)`, the page text, and the font descriptions. -/
def extract (b : ByteArray) : Option (List (String × Int) × String × List String) :=
  match Doc.openDoc {} b with
  | .ok d =>
    match d.pages.toList with
    | p :: _ =>
      match (extractDocPage {} d p (Filter.Budget.init {})).1 with
      | .ok t => some (t.glyphs.map (fun g => (g.text, g.x.raw / 1000)), t.text,
          t.fonts.map (·.2.desc))
      | .error _ => none
    | [] => none
  | .error _ => none

/-- TrueType width cases: label, PDF, expected glyphs, whether the program is read. -/
def ttCases (ttf : ByteArray) : List (String × ByteArray × List (String × Int) × Bool) :=
  -- ToUnicode maps CID k to 'A' + k; 10 pt font: an advance of 600 is 6 pt
  [ ("CIDFontType2, /CIDToGIDMap /Identity",
      cidDoc ttf "/CIDToGIDMap /Identity" "BT /F1 10 Tf 72 700 Td <00000001000200030009> Tj ET",
      [("A", 72000), ("B", 77000), ("C", 79500), ("D", 85500), ("J", 91500)], true),
    ("CIDFontType2, no /CIDToGIDMap (identity)",
      cidDoc ttf "" "BT /F1 10 Tf 72 700 Td <00010002> Tj ET",
      [("B", 72000), ("C", 74500)], true),
    -- map: CID 0 → 2, 1 → 1, 2 → 0, 3 → 9 (not in the font); CID 4 is past the map
    ("CIDFontType2, /CIDToGIDMap stream",
      cidDoc ttf "/CIDToGIDMap 10 0 R" "BT /F1 10 Tf 72 700 Td <0000000100020003000400> Tj ET"
        "0002000100000009",
      [("A", 72000), ("B", 78000), ("C", 80500), ("D", 85500), ("E", 95500), (replacementStr, 105500)],
      true),
    ("CIDFontType2, /W first, then the program",
      cidDoc ttf "/W [1 [300]]" "BT /F1 10 Tf 72 700 Td <000100020000> Tj ET",
      [("B", 72000), ("C", 75000), ("A", 81000)], true),
    ("CIDFontType2, /DW wins (program not read)",
      cidDoc ttf "/DW 800" "BT /F1 10 Tf 72 700 Td <00010002> Tj ET",
      [("B", 72000), ("C", 80000)], false),
    -- simple TrueType, no /Widths, non-symbolic: A → gid 2 (600), space → gid 1 (250)
    ("TrueType, no /Widths, non-symbolic",
      simpleDoc ttf "SafePdfTinyTT" 32 "" "BT /F1 10 Tf 72 700 Td (A A) Tj ET",
      [("A", 72000), (" ", 78000), ("A", 80500)], true),
    -- symbolic: (3,0) 0xF041 → gid 2, 0xF042 → gid 4; code 0x43 has no glyph: width 0
    ("TrueType, no /Widths, symbolic",
      simpleDoc ttf "SafePdfTinyTT" 4 "" "BT /F1 10 Tf 72 700 Td (ABCA) Tj ET",
      [("A", 72000), ("B", 78000), ("C", 84000), ("A", 84000)], true),
    -- the program wins over Helvetica's AFM width (A 667)
    ("TrueType, no /Widths, standard 14 name",
      simpleDoc ttf "Helvetica" 32 "" "BT /F1 10 Tf 72 700 Td (AA) Tj ET",
      [("A", 72000), ("A", 78000)], true),
    -- /Widths covers A only (900); the space is outside FirstChar..LastChar: program (250)
    ("TrueType, /Widths missing a code",
      simpleDoc ttf "SafePdfTinyTT" 32 "/FirstChar 65 /LastChar 65 /Widths [900]"
        "BT /F1 10 Tf 72 700 Td (A A) Tj ET",
      [("A", 72000), (" ", 81000), ("A", 83500)], true),
    ("TrueType, /Widths for every code (program not read)",
      simpleDoc ttf "SafePdfTinyTT" 32
        ("/FirstChar 0 /LastChar 255 /Widths [" ++ " ".intercalate (List.replicate 256 "700") ++ "]")
        "BT /F1 10 Tf 72 700 Td (AA) Tj ET",
      [("A", 72000), ("A", 79000)], false) ]

/-- Helvetica pages for the layout cases. -/
def helvDoc (c : String) : ByteArray :=
  doc "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>" c []

/-- Sub/superscript cases: label, content, expected page text. The expected texts are those of
`mutool draw -F txt` (MuPDF 1.25.1) on the same pages; `pdftotext` (poppler) differs on the
`Td`, footnote and two-line cases, where it puts the raised glyph on a line of its own. In the
stacked case MuPDF starts a new line at the backward move of the superscript ("Sum xi" /
"2 over i."); this extraction sorts a line's glyphs left to right and keeps both scripts on
the line (poppler: "Sum x2i over i."). -/
def layoutCases : List (String × String × String) :=
  [ ("superscript and subscript by Ts",
      "BT /F1 10 Tf 72 700 Td (A footnote) Tj /F1 7 Tf 4 Ts (1) Tj /F1 10 Tf 0 Ts " ++
        "( and x) Tj /F1 7 Tf -2 Ts (2) Tj /F1 10 Tf 0 Ts ( end.) Tj ET",
      "A footnote1 and x2 end."),
    ("superscript raised 0.55 em by Td",
      "BT /F1 10 Tf 72 700 Td (Energy E=mc) Tj ET BT /F1 7 Tf 132.3 705.5 Td (2) Tj ET " ++
        "BT /F1 10 Tf 136.2 700 Td ( holds.) Tj ET",
      "Energy E=mc2 holds."),
    ("footnote line begun by its marker",
      "BT /F1 7 Tf 72 104 Td (1) Tj ET BT /F1 10 Tf 76 100 Td (The footnote text.) Tj ET " ++
        "BT /F1 10 Tf 72 88 Td (Next line.) Tj ET",
      "1The footnote text.\nNext line."),
    ("footnote marker raised 0.55 em, then a word gap",
      "BT /F1 7 Tf 72 105.5 Td (2) Tj ET BT /F1 10 Tf 78 100 Td (Second note.) Tj ET",
      "2 Second note."),
    ("superscript on the second of two lines 12 pt apart",
      "BT /F1 10 Tf 72 700 Td (First line here) Tj ET BT /F1 10 Tf 72 688 Td (Second x) Tj ET " ++
        "BT /F1 7 Tf 113.7 693.5 Td (n) Tj ET BT /F1 10 Tf 117.6 688 Td ( tail) Tj ET",
      "First line here\nSecond xn tail"),
    ("stacked subscript and superscript",
      "BT /F1 10 Tf 72 700 Td (Sum x) Tj ET BT /F1 7 Tf 100.34 697 Td (i) Tj ET " ++
        "BT /F1 7 Tf 100.34 704.5 Td (2) Tj ET BT /F1 10 Tf 104.3 700 Td ( over i.) Tj ET",
      "Sum xi2 over i."),
    ("raised glyph far after the line end stays apart",
      "BT /F1 10 Tf 72 700 Td (Word one two) Tj ET BT /F1 7 Tf 200 705.5 Td (9) Tj ET",
      "Word one two\n9") ]

/-- Run the cases; the number of failures. -/
def run : IO Nat := do
  let ttf ← IO.FS.readBinFile "Tests/fonts/tiny.ttf"
  let mut bad := 0
  for (label, pdf, glyphs, wantProg) in ttCases ttf do
    match extract pdf with
    | some (gs, _, descs) =>
      let hasProg := descs.any fun d => (d.splitOn "FontFile2").length > 1
      if gs != glyphs || hasProg != wantProg then
        IO.println s!"  FAIL {label}: got {gs} {descs}, expected {glyphs} (program read: {wantProg})"
        bad := bad + 1
    | none =>
      IO.println s!"  FAIL {label}: extraction failed"
      bad := bad + 1
  for (label, c, text) in layoutCases do
    match extract (helvDoc c) with
    | some (_, t, _) =>
      if t != text then
        IO.println s!"  FAIL {label}: got {repr t}, expected {repr text}"
        bad := bad + 1
    | none =>
      IO.println s!"  FAIL {label}: extraction failed"
      bad := bad + 1
  return bad

end SafePdf.Tests.TextLayout
