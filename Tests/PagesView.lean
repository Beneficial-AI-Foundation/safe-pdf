import SafePdf
import SafePdf.Shell.Views.Pages
import Tests.Golden

/-!
# Golden tests of the `pages` and `outline` inspector views (task 4.4)

Each input under `Tests/golden/pages/` (tiny PDFs generated by
`Tests/golden/generate_pages.py`: page-tree inheritance and clipping, page labels, links, an
outline with cycles and named destinations, a page shared by two parents) is rendered with
the deterministic text and JSON forms of `SafePdf.Shell.Views.Pages` (no timings), in four
sections separated by `--- <view>` lines, and compared with `<input>.expected` by
`Tests.Golden.runCase` (Plan.md §6 Phase 4, M4 page-tree + outline browser).
`SAFEPDF_GOLDEN_UPDATE=1` regenerates.
-/

namespace SafePdf.Tests.PagesView

open SafePdf.Shell.Views.Pages

/-- Directory of the inputs. -/
def dir : System.FilePath := Tests.Golden.goldenRoot / "pages"

/-- Render one input: `pages` and `outline`, text and JSON (the path is shown as `input`). -/
def render (bytes : ByteArray) : String :=
  let l := Limits.default
  let r := SafePdf.parseWith l bytes
  let lines :=
    ["--- pages"] ++ pagesText "input" l r ++
    ["--- pages --json"] ++ pagesJson "input" l r ++
    ["--- outline"] ++ outlineText "input" l r ++
    ["--- outline --json"] ++ outlineJson "input" l r
  "\n".intercalate lines ++ "\n"

/-- Run the suite; returns the number of failures. -/
def run : IO Nat := do
  let update := (← IO.getEnv Tests.Golden.updateEnvVar) == some "1"
  if !(← dir.isDir) then
    IO.println s!"  FAIL pages view: directory {dir} not found (run from the repo root)"
    return 1
  let inputs := ((← dir.readDir).map (·.path)).toList.filter Tests.Golden.isInput
  let inputs := inputs.toArray.qsort (fun a b => a.toString < b.toString)
  if inputs.isEmpty then
    IO.println s!"  FAIL pages view: no input files in {dir}"
    return 1
  let mut c : Tests.Golden.Counts := {}
  for input in inputs do
    c ← Tests.Golden.runCase update render input c
  if update then IO.println s!"  pages view: wrote {c.written} .expected file(s)"
  else IO.println s!"  pages view: {c.cases} case(s), {c.failures} failure(s)"
  return c.failures

end SafePdf.Tests.PagesView
