import SafePdf.Quarantine.DCT
import SafePdf.Core.Raster.Image

/-!
# JPEG decoder suite (tasks 7.6a baseline, 7.6b progressive)

Plan.md §3 (quarantine zone, revalidation), §6 Phase 7. Checks `SafePdf.Quarantine.DCT`:

* **fixtures** `Tests/images/*.jpg` (generated by `Tests/images/gen_jpegs.py` with
  libjpeg-turbo's `cjpeg`: gray, 4:4:4, 4:2:2, 4:2:0, 4:4:0, 4:1:1, a 3-pixel-wide 4:2:0
  image (plain replication), restart intervals, an RGB JPEG (Adobe transform 0), quality
  100 (16-bit-range coefficients), three non-interleaved scans, and CMYK / YCCK files with
  an Adobe marker assembled from four scans; progressive (7.6b, `p*`): `cjpeg -progressive`
  gray / 4:4:4 / 4:2:2 / 4:2:0, a 3-pixel-wide image, restart intervals, quality 100,
  refinement-heavy `-scans` scripts (colour, colour with restarts, gray with single-coefficient
  bands), a smooth image (long end-of-band runs) and `jpegtran -progressive` of the CMYK
  file; 7.6c: files without `DHT` (standard tables), truncated baseline files (grey tail),
  truncated and DC-only progressive files (block smoothing), files cut inside a `DHT`
  between scans) against `Tests/images/*.ref` — the decode of
  `djpeg -dct int`, i.e. libjpeg-turbo with MuPDF's settings (islow IDCT, fancy upsampling).
  Expected: **bit-exact** (the count of differing samples and the largest difference are
  printed on failure);
* **malformed input** is an error, never a crash: no `SOI`, a truncated header, a
  lossless / arithmetic `SOF`, a sequential scan in a progressive frame, bad progression
  parameters (`Al > 13`, an AC band of two components, `Se < Ss`), more than
  `DCT.maxScans` scans (256 scans decode), a cut progressive file, 12-bit precision, an over-full Huffman table, a scan
  before its frame, the `maxImagePixels` limit; a JPEG cut in the middle of its entropy
  data still decodes (zero bits, like libjpeg); 2000 single-byte corruptions and 300
  truncations of the fixtures each either fail or keep the size law;
* **wiring**: `Image.decodeDCT` re-validates against the image dictionary (component
  mismatch → error; a missing `/ColorSpace` from the JPEG; `/Decode [1 0 …]` inverts), and
  a `/DCTDecode` XObject decodes through `loadImages` (a broken one is the placeholder);
* **timing** (printed): a synthetic 1008 × 1008 4:2:0 stream built here (`synth420`: small
  Huffman tables, DC differences and one AC coefficient per other block) — a fixture of
  that size would not fit the fixture budget — and its progressive twin (`synthProg`: DC
  scan, per component an AC first scan that is one end-of-band run and an AC refinement
  that makes the coefficients nonzero), which must decode to the same samples;
  `SAFEPDF_DCT_BENCH=FILE` also times the decoding of `FILE`.
-/

namespace SafePdf.Tests.DCT

open SafePdf
open SafePdf.Quarantine

/-- Fixture names (files `Tests/images/NAME.jpg` / `.ref`). -/
def fixtures : List String :=
  ["gray", "s444", "s422", "s420", "s440", "s411", "narrow", "rst", "rgb", "q100", "scans",
   "cmyk", "ycck", "pgray", "p444", "p422", "p420", "pnarrow", "prst", "pq100", "pscans",
   "pscanrst", "pscangray", "psmooth", "pcmyk", "nodht", "nodhtgray", "ts420", "trst", "tgray",
   "tp420", "tp420b", "tp444", "tpgray", "tprst", "tpscans", "tpscanrst", "tpscangray", "tpsmooth",
   "tpnarrow", "tdhtp", "tdhts", "dcp420", "dcpgray"]

/-- Parse a reference file: header line `W H NC`, then the samples. -/
def parseRef (b : ByteArray) : Option (Nat × Nat × Nat × ByteArray) := do
  let nl ← (List.range (min b.size 64)).find? (fun i => b.get! i == 10)
  let hdr := String.fromUTF8! (b.extract 0 nl)
  match (hdr.splitOn " ").map String.toNat? with
  | [some w, some h, some nc] => some (w, h, nc, b.extract (nl + 1) b.size)
  | _ => none

/-- Number of differing samples and the largest difference. -/
def diff (a b : ByteArray) : Nat × Nat := Id.run do
  let mut n := 0
  let mut mx := 0
  for i in [0:min a.size b.size] do
    let x := (a.get! i).toNat
    let y := (b.get! i).toNat
    let d := if x < y then y - x else x - y
    if d ≠ 0 then
      n := n + 1
      mx := max mx d
  return (n + (max a.size b.size - min a.size b.size), mx)

/-- Is `r` an error? -/
def isErr {α : Type} : Except Error α → Bool
  | .error _ => true
  | .ok _ => false

/-- Does a decode keep the size law (or fail)? -/
def lawOk (r : Except Error DCT.Image) : Bool :=
  match r with
  | .ok img => img.data.size == img.w * img.h * img.nc && img.nc ≤ 4 && 0 < img.w * img.h
  | .error _ => true

/-- Replace byte `i` by `v`. -/
def patch (b : ByteArray) (i : Nat) (v : Nat) : ByteArray :=
  if h : i < b.size then b.set i (UInt8.ofNat v) h else b

/-- Position of the first marker `FF m`. -/
def findMarker (b : ByteArray) (m : Nat) : Option Nat :=
  (List.range (b.size - 1)).find? fun i => b.get! i == 0xFF && (b.get! (i + 1)).toNat == m

/-- Bit writer for the synthetic timing stream: bytes so far, pending bits (MSB first). -/
structure BW where
  /-- Bytes. -/
  out : ByteArray := ByteArray.empty
  /-- Pending bits. -/
  acc : Nat := 0
  /-- Number of pending bits. -/
  n : Nat := 0

/-- Append the `len` low bits of `code` (with `FF 00` stuffing). -/
def BW.put (w : BW) (code len : Nat) : BW := Id.run do
  let mut w := { w with acc := w.acc * 2 ^ len + code % 2 ^ len, n := w.n + len }
  for _ in [0:4] do
    if w.n < 8 then break
    let b := w.acc / 2 ^ (w.n - 8)
    let out := w.out.push (UInt8.ofNat b)
    let out := if b = 0xFF then out.push 0 else out
    w := { out, acc := w.acc % 2 ^ (w.n - 8), n := w.n - 8 }
  return w

/-- A synthetic baseline 4:2:0 JPEG of `mx × my` MCUs (`16 mx × 16 my` pixels): one DC table
(categories 0–11 as 4-bit codes) and one AC table (`EOB` and `0x01`, 2-bit codes); block
`k` gets the DC difference `±(k mod 7)` and an AC coefficient 1 at zig-zag 1 every other
block, so that both IDCT paths run. -/
def synth420 (mx my : Nat) : ByteArray := Id.run do
  let seg := fun (m : Nat) (body : List Nat) =>
    [0xFF, m, (body.length + 2) / 256, (body.length + 2) % 256] ++ body
  let dqt := seg 0xDB (0 :: List.replicate 64 2)
  -- DC: 12 symbols of length 4.
  let dht0 := seg 0xC4 (0x00 :: ([0, 0, 0, 12] ++ List.replicate 12 0) ++ List.range 12)
  -- AC: 2 symbols of length 2: 0x00 (EOB) = 00, 0x01 = 01.
  let dht1 := seg 0xC4 (0x10 :: ([0, 2] ++ List.replicate 14 0) ++ [0x00, 0x01])
  let w := 16 * mx
  let h := 16 * my
  let sof := seg 0xC0 [8, h / 256, h % 256, w / 256, w % 256, 3, 1, 0x22, 0, 2, 0x11, 0, 3, 0x11, 0]
  let sos := seg 0xDA [3, 1, 0x00, 2, 0x00, 3, 0x00, 0, 63, 0]
  let hdr := [0xFF, 0xD8] ++ dqt ++ dht0 ++ dht1 ++ sof ++ sos
  let mut bw : BW := {}
  let mut k := 0
  for _ in [0:mx * my] do
    for _ in [0:6] do
      let d := k % 7
      let cat := if d = 0 then 0 else if d < 2 then 1 else if d < 4 then 2 else 3
      bw := bw.put cat 4
      if 0 < cat then
        bw := bw.put (if k % 2 = 0 then d else (2 ^ cat - 1 - d)) cat
      if k % 2 = 0 then
        bw := bw.put 1 2
        bw := bw.put 1 1
      bw := bw.put 0 2
      k := k + 1
  bw := bw.put 0x7F 7
  return ByteArray.mk (hdr.map UInt8.ofNat).toArray ++ bw.out ++ ByteArray.mk #[0xFF, 0xD9]

/-- Zero-padded bits to the next byte boundary (1-bits, like libjpeg's padding). -/
def BW.flush (w : BW) : BW := if w.n % 8 = 0 then w else w.put (2 ^ (8 - w.n % 8) - 1) (8 - w.n % 8)

/-- The progressive twin of `synth420 mx my` (same coefficients, so the same samples):
`SOF2`; an interleaved DC first scan (the DC codes of `synth420`); for each component an AC
first scan of band 1–63 at `Al = 1` (all zero: one end-of-band run over the component) and
an AC refinement `Ah = 1, Al = 0` making coefficient 1 equal to 1 in every block of even
`synth420` index (a newly nonzero coefficient, then `EOB`; other blocks: `EOB`). Full
bands: every coefficient ends at full precision, so libjpeg applies no block smoothing.
AC table: `EOB0`, `0x01`, `EOB1 … EOB14`, 5-bit codes `0, 1, 2, …`. -/
def synthProg (mx my : Nat) : ByteArray := Id.run do
  let seg := fun (m : Nat) (body : List Nat) =>
    [0xFF, m, (body.length + 2) / 256, (body.length + 2) % 256] ++ body
  let dqt := seg 0xDB (0 :: List.replicate 64 2)
  let dht0 := seg 0xC4 (0x00 :: ([0, 0, 0, 12] ++ List.replicate 12 0) ++ List.range 12)
  let dht1 := seg 0xC4 (0x10 :: ([0, 0, 0, 0, 16] ++ List.replicate 11 0) ++
    (0x00 :: 0x01 :: (List.range 14).map (fun r => (r + 1) * 16)))
  let w := 16 * mx
  let h := 16 * my
  let sof := seg 0xC2 [8, h / 256, h % 256, w / 256, w % 256, 3, 1, 0x22, 0, 2, 0x11, 0, 3, 0x11, 0]
  let mut out : List Nat := [0xFF, 0xD8] ++ dqt ++ dht0 ++ dht1 ++ sof ++
    seg 0xDA [3, 1, 0x00, 2, 0x00, 3, 0x00, 0, 0, 0]
  let mut bw : BW := {}
  let mut k := 0
  for _ in [0:mx * my] do
    for _ in [0:6] do
      let d := k % 7
      let cat := if d = 0 then 0 else if d < 2 then 1 else if d < 4 then 2 else 3
      bw := bw.put cat 4
      if 0 < cat then
        bw := bw.put (if k % 2 = 0 then d else (2 ^ cat - 1 - d)) cat
      k := k + 1
  let mut body := bw.flush.out
  for c in [0:3] do
    let (bw2, bh2) := if c = 0 then (2 * mx, 2 * my) else (mx, my)
    let n := bw2 * bh2
    -- AC first, band 1-63, Al = 1: one end-of-band run of n blocks.
    out := out ++ (body.toList.map (·.toNat)) ++ seg 0xDA [1, c + 1, 0x00, 1, 63, 0x01]
    let r := Nat.log2 n
    bw := {}
    bw := bw.put (if r = 0 then 0 else r + 1) 5
    if 0 < r then bw := bw.put (n - 2 ^ r) r
    out := out ++ (bw.flush.out.toList.map (·.toNat)) ++ seg 0xDA [1, c + 1, 0x00, 1, 63, 0x10]
    -- AC refinement, Ah = 1, Al = 0.
    bw := {}
    for by_ in [0:bh2] do
      for bx in [0:bw2] do
        let kk := if c = 0 then ((by_ / 2) * mx + bx / 2) * 6 + (by_ % 2) * 2 + bx % 2
          else (by_ * mx + bx) * 6 + 3 + c
        if kk % 2 = 0 then
          bw := bw.put 1 5
          bw := bw.put 1 1
          bw := bw.put 0 5
        else bw := bw.put 0 5
    body := bw.flush.out
  out := out ++ (body.toList.map (·.toNat)) ++ [0xFF, 0xD9]
  return ByteArray.mk (out.map UInt8.ofNat).toArray

/-- A progressive JPEG with `n` extra DC refinement scans (one zero byte of data each)
appended to `base` before its `EOI`. -/
def extraScans (base : ByteArray) (n : Nat) : ByteArray := Id.run do
  let mut b := base.extract 0 (base.size - 2)
  for _ in [0:n] do
    b := b ++ ByteArray.mk #[0xFF, 0xDA, 0, 8, 1, 1, 0, 0, 0, 0x10, 0]
  return b ++ ByteArray.mk #[0xFF, 0xD9]

/-- `b` without the `DHT` segments before its first `SOS` (at most 64 segments). -/
def stripDHT (b : ByteArray) : ByteArray := Id.run do
  let mut out := b.extract 0 2
  let mut i := 2
  for _ in [0:64] do
    if b.size ≤ i + 3 || b.get! (i + 1) == 0xDA then break
    let e := i + 2 + (b.get! (i + 2)).toNat * 256 + (b.get! (i + 3)).toNat
    if b.get! (i + 1) != 0xC4 then out := out ++ b.extract i e
    i := e
  return out ++ b.extract i b.size

/-- A baseline JPEG claiming `w × h` pixels (the `SOF0` of `b` patched) whose data stops early:
libjpeg leaves the rest grey, and the decoder must not decode it block by block. -/
def hugeCut (b : ByteArray) (w h : Nat) : ByteArray :=
  let sof := (findMarker b 0xC0).getD 0
  let b := patch (patch (patch (patch b (sof + 5) (h / 256)) (sof + 6) (h % 256)) (sof + 7) (w / 256))
    (sof + 8) (w % 256)
  let sos := (findMarker b 0xDA).getD 0
  b.extract 0 (sos + 200)

/-- Run the suite. -/
def run : IO Nat := do
  let mut failures := 0
  let report := fun (msg : String) => IO.println s!"  FAIL dct: {msg}"
  let dir : System.FilePath := "Tests" / "images"
  let mut decoded : Array ByteArray := #[]
  -- 1. Fixtures, bit-exact against libjpeg-turbo.
  for name in fixtures do
    let jpg ← IO.FS.readBinFile (dir / s!"{name}.jpg")
    let ref ← IO.FS.readBinFile (dir / s!"{name}.ref")
    decoded := decoded.push jpg
    match parseRef ref, DCT.decode {} none jpg with
    | some (w, h, nc, exp), .ok img =>
      let (n, mx) := diff img.data exp
      if img.w != w || img.h != h || img.nc != nc || n != 0 then
        failures := failures + 1
        report s!"{name}: {img.w}x{img.h}x{img.nc} vs {w}x{h}x{nc}, {n} samples differ (max {mx})"
    | none, _ => failures := failures + 1; report s!"{name}: bad reference file"
    | _, .error e => failures := failures + 1; report s!"{name}: {repr e}"
  -- 2. Malformed input.
  let s420 ← IO.FS.readBinFile (dir / "s420.jpg")
  let sof := (findMarker s420 0xC0).getD 0
  let dht := (findMarker s420 0xC4).getD 0
  let sos := (findMarker s420 0xDA).getD 0
  let bad : List (String × ByteArray × (Except Error DCT.Image → Bool)) :=
    [ ("empty", ByteArray.empty, isErr),
      ("no SOI", s420.extract 2 s420.size, isErr),
      ("truncated header", s420.extract 0 (sof + 6), isErr),
      ("lossless", patch s420 (sof + 1) 0xC3,
        fun r => match r with | .error (.unsupported _) => true | _ => false),
      ("sequential scan in a progressive frame", patch s420 (sof + 1) 0xC2,
        fun r => match r with | .error (.malformed _ _) => true | _ => false),
      ("arithmetic", patch s420 (sof + 1) 0xC9,
        fun r => match r with | .error (.unsupported _) => true | _ => false),
      ("12-bit", patch s420 (sof + 4) 12,
        fun r => match r with | .error (.unsupported _) => true | _ => false),
      -- 2 codes of length 1 plus more: overflow.
      ("bad Huffman table", patch (patch s420 (dht + 5) 2) (dht + 6) 1, isErr),
      ("scan before frame", (s420.extract 0 sof) ++ (s420.extract sos s420.size), isErr),
      ("cut in the scan", s420.extract 0 (sos + 40), fun r => !isErr r && lawOk r) ]
  let pgray ← IO.FS.readBinFile (dir / "pgray.jpg")
  let p420 ← IO.FS.readBinFile (dir / "p420.jpg")
  let psos := (findMarker p420 0xDA).getD 0
  -- The first scan of p420 is the interleaved DC scan (3 components): Ss, Se, AhAl at +11.
  let psosAc := ((List.range (p420.size - 1)).filter fun i =>
    p420.get! i == 0xFF && p420.get! (i + 1) == 0xDA).getD 1 0
  let bad := bad ++
    [ ("Al > 13", patch p420 (psos + 13) 0x0E, isErr),
      ("DC scan with Se > 0", patch p420 (psos + 12) 5, isErr),
      ("AC band of two components", patch (patch p420 (psos + 11) 1) (psos + 12) 5, isErr),
      ("AC scan Se < Ss", patch (patch p420 (psosAc + 7) 9) (psosAc + 8) 3, isErr),
      ("too many scans", extraScans pgray 260,
        fun r => match r with | .error (.unsupported _) => true | _ => false),
      ("many scans", extraScans pgray 250, fun r => !isErr r && lawOk r),
      ("cut progressive", p420.extract 0 (p420.size / 2), fun r => !isErr r && lawOk r),
      -- libjpeg-turbo supplies standard tables to sequential frames only (`jdhuff.c`).
      ("progressive without DHT", stripDHT p420, isErr),
      ("sequential without DHT", stripDHT s420, fun r => !isErr r && lawOk r),
      -- A frame header cut by the end of the data stays an error.
      ("cut in SOF", s420.extract 0 (sof + 8), isErr) ]
  for (what, b, ok) in bad do
    if !ok (DCT.decode {} none b) then
      failures := failures + 1; report s!"malformed: {what}"
  match DCT.decode { maxImagePixels := 100 } none s420 with
  | .error (.limitExceeded .imagePixels) => pure ()
  | _ => failures := failures + 1; report "maxImagePixels limit"
  -- 2b. Time bound: a truncated baseline JPEG claiming 4096 × 4096 pixels.
  let gray ← IO.FS.readBinFile (dir / "gray.jpg")
  let huge := hugeCut gray 4096 4096
  let t0 ← IO.monoNanosNow
  match DCT.decode {} none huge with
  | .ok img =>
    let t1 ← IO.monoNanosNow
    IO.println s!"  dct: truncated {img.w}x{img.h} gray ({huge.size} bytes) decoded in {(t1 - t0) / 1000000} ms"
    if img.w != 4096 || img.h != 4096 || img.data.get! (img.data.size - 1) != 128 then
      failures := failures + 1; report "truncated huge JPEG: size or grey tail"
  | .error e => failures := failures + 1; report s!"truncated huge JPEG: {repr e}"
  -- 3. Corruptions and truncations keep the size law.
  let mut seed := 12345
  let mut viol := 0
  for t in [0:2300] do
    seed := (seed * 1103515245 + 12345) % 2147483648
    let src := decoded.getD (t % decoded.size) ByteArray.empty
    let pos := (seed / 7) % (max 1 src.size)
    let b := if t < 2000 then patch src pos ((seed / 65536) % 256) else src.extract 0 pos
    if !lawOk (DCT.decode {} none b) then viol := viol + 1
  if viol != 0 then failures := failures + 1; report s!"{viol} corrupt inputs broke the size law"
  -- 4. Wiring through the image layer.
  let gray ← IO.FS.readBinFile (dir / "gray.jpg")
  let dict : Core.Raster.Image.ImgDict :=
    { w := 33, h := 27, bpc := some 8, mask := false, decode := none, interp := false, cs := none }
  let grayCS : Option Core.Content.Run.CSInfo := some (.dev .gray (.gray Core.Content.Comp.zero))
  let rgbCS : Option Core.Content.Run.CSInfo := some (.dev .rgb (.gray Core.Content.Comp.zero))
  let refGray := match parseRef (← IO.FS.readBinFile (dir / "gray.ref")) with
    | some (_, _, _, d) => d
    | none => ByteArray.empty
  match Core.Raster.Image.decodeDCT {} dict grayCS [] gray with
  | .ok pm =>
    if pm.w != 33 || pm.h != 27 || pm.data.get! 4 != refGray.get! 1 || pm.data.get! 7 != 255 then
      failures := failures + 1; report "decodeDCT gray"
  | .error e => failures := failures + 1; report s!"decodeDCT gray: {repr e}"
  if !isErr (Core.Raster.Image.decodeDCT {} dict rgbCS [] gray) then
    failures := failures + 1; report "decodeDCT: component mismatch accepted"
  match Core.Raster.Image.decodeDCT {} dict none [] gray,
      Core.Raster.Image.decodeDCT {} { dict with decode := some [1, 0] } grayCS [] gray with
  | .ok a, .ok b =>
    if a.data.get! 0 != refGray.get! 0 || b.data.get! 0 != 255 - refGray.get! 0 then
      failures := failures + 1; report "decodeDCT: inferred space / Decode"
  | _, _ => failures := failures + 1; report "decodeDCT: inferred space / Decode failed"
  -- A /DCTDecode XObject (inside a Flate-free chain) through loadImages.
  let nmS := fun (s : String) => Name.ofString s
  let xd : Dict := [(nmS "Subtype", .name (nmS "Image")), (nmS "Width", .int 33),
    (nmS "Height", .int 27), (nmS "BitsPerComponent", .int 8),
    (nmS "ColorSpace", .name (nmS "DeviceGray")), (nmS "Filter", .array [.name (nmS "DCTDecode")])]
  let src : Core.Content.Source Unit :=
    ⟨fun s n _ => (if n = 5 then .ok (.stream ⟨xd, gray⟩)
        else if n = 6 then .ok (.stream ⟨xd, ByteArray.mk #[0xFF, 0xD8, 0xFF]⟩)
        else .error (.malformed 0 "missing"), s),
     fun s _ st => (Core.Filter.decodeBytes {} st.dict st.data (.unsupported "image codec"), s)⟩
  let m : Core.Content.Matrix := ⟨Core.Content.Fixed.ofInt 1, Core.Content.Fixed.zero,
    Core.Content.Fixed.zero, Core.Content.Fixed.ofInt 1, Core.Content.Fixed.zero, Core.Content.Fixed.zero⟩
  let fill : Core.Content.FillStyle := { color := .gray Core.Content.Comp.zero, alpha := Core.Content.Comp.one }
  let items : Core.Content.DisplayList :=
    #[.image (.xobject (nmS "Im1") 5 0) m fill [], .image (.xobject (nmS "Im2") 6 0) m fill []]
  let (tbl, _) := Core.Raster.Image.loadImages {} src () [] items
  match tbl.pixmap (.xobject (nmS "Im1") 5 0), tbl.pixmap (.xobject (nmS "Im2") 6 0) with
  | some a, some b =>
    if a.w != 33 || a.h != 27 || a.data.get! 0 != refGray.get! 0 || b.w != 1 || b.h != 1 then
      failures := failures + 1; report s!"loadImages DCT: {a.w}x{a.h} {b.w}x{b.h}"
  | _, _ => failures := failures + 1; report "loadImages DCT: missing pixmaps"
  -- 5. Timing (synthetic 4:2:0, 1008 × 1008), baseline and progressive.
  let big := synth420 63 63
  let t0 ← IO.monoNanosNow
  let bigImg := DCT.decode {} none big
  match bigImg with
  | .ok img =>
    let t1 ← IO.monoNanosNow
    IO.println s!"  dct: synthetic 4:2:0 {img.w}x{img.h} ({big.size} bytes) decoded in {(t1 - t0) / 1000000} ms"
  | .error e => failures := failures + 1; report s!"synthetic 4:2:0: {repr e}"
  let bigP := synthProg 63 63
  let t0 ← IO.monoNanosNow
  match DCT.decode {} none bigP, bigImg with
  | .ok img, .ok ref =>
    let t1 ← IO.monoNanosNow
    IO.println s!"  dct: synthetic progressive 4:2:0 {img.w}x{img.h} ({bigP.size} bytes) decoded in {(t1 - t0) / 1000000} ms"
    let (n, mx) := diff img.data ref.data
    if n != 0 then failures := failures + 1; report s!"synthetic progressive: {n} samples differ from baseline (max {mx})"
  | .error e, _ => failures := failures + 1; report s!"synthetic progressive 4:2:0: {repr e}"
  | _, _ => pure ()
  if let some path ← IO.getEnv "SAFEPDF_DCT_BENCH" then
    let b ← IO.FS.readBinFile path
    let t0 ← IO.monoNanosNow
    match DCT.decode {} none b with
    | .ok img =>
      let t1 ← IO.monoNanosNow
      IO.println s!"  dct: {path} {img.w}x{img.h}x{img.nc} decoded in {(t1 - t0) / 1000000} ms"
      let refPath := (System.FilePath.mk path).withExtension "ref"
      if ← refPath.pathExists then
        match parseRef (← IO.FS.readBinFile refPath) with
        | some (_, _, _, exp) =>
          let (n, mx) := diff img.data exp
          IO.println s!"  dct: {refPath}: {n} samples differ (max {mx})"
        | none => IO.println s!"  dct: {refPath}: bad reference file"
    | .error e => IO.println s!"  dct: {path}: {repr e}"
  return failures

end SafePdf.Tests.DCT
