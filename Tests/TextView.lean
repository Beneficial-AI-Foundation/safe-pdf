import SafePdf
import SafePdf.Shell.Views.Text
import Tests.Golden

/-!
# Golden tests of the `text` inspector view and the `svg` text overlay (task 6.6)

Each input under `Tests/golden/text/` (tiny PDFs generated by `Tests/golden/generate_text.py`:
simple fonts with standard encodings, word gaps, kerning, paragraph gaps, right-to-left
showing, fake bold, invisible text, a Type0 font with a `/ToUnicode` CMap and an unmapped
code, rotated text, a page whose contents do not decode) is rendered in sections separated by
`--- <name>` lines and compared with `<input>.expected` by `Tests.Golden.runCase` (Plan.md §6
Phase 6, M6 row of the MVP / visibility track):

* `text`: the text form of all pages with per-glyph lines (`SAFEPDF_TEXT_GLYPHS=1`);
* `json`: the `--json` form (no glyph list), then the `SAFEPDF_PAGE=1` form with glyph list;
* `page out of range`: the result for a page number past the end (`none`);
* `svg overlay page N`: the `SAFEPDF_SVG_TEXT=1` glyph boxes of every page.

`SAFEPDF_GOLDEN_UPDATE=1` regenerates.

Task 6.8d (`/ActualText`): `actualtext.pdf` covers a dot leader whose space carries '.', an
ActualText spanning two shows, fewer and more characters than glyphs, an empty ActualText,
nesting, a `/Properties` resource name, a UTF-16 ligature, plain marked content with a stray
`EMC` and a sequence left open; besides its golden file, its page text must equal MuPDF's
(`actualTextFailures`).

Task 6.12 (text of encrypted files): `enc-plain.pdf` is one page with a Helvetica font with
`/Differences`, a Type0 font with a FlateDecode `/ToUnicode` stream, a TrueType font whose
widths come from its FlateDecode `/FontFile2` (`Tests/fonts/tiny.ttf`), a form XObject with its
own font resources, and a `Tf` naming no resource (MuPDF's substitute Times-Roman);
`enc-rc4-40.pdf`, `enc-rc4-128.pdf`, `enc-aes-128.pdf` and `enc-aes-256.pdf` are the same file
encrypted by qpdf 12.2 with an empty user password (`qpdf --static-id --static-aes-iv
--allow-weak-crypto --object-streams=disable --stream-data=preserve --encrypt "" owner
40|128 [--use-aes=n|y]|256 -- enc-plain.pdf OUT`). Besides their golden files, each must render
exactly as `enc-plain.pdf` (`encryptedFailures`), and every fixture of
`Tests/adversarial/encrypted/` must show `Hello, encrypted world` without U+FFFD, or fail to
open when it is meant to (`adversarialFailures`; those pages have no `/Resources`, so their
`/F1` is the substitute font).
-/

namespace SafePdf.Tests.TextView

open SafePdf.Shell.Views

/-- Directory of the inputs. -/
def dir : System.FilePath := Tests.Golden.goldenRoot / "text"

/-- Render one input (the path is shown as `input`). -/
def render (bytes : ByteArray) : String :=
  let l := Limits.default
  let r := SafePdf.parseWith l bytes
  match SafePdf.Shell.Views.Pages.docOf l r with
  | .error e => s!"error: {SafePdf.Shell.renderError e}\n"
  | .ok doc =>
    let txt : SafePdf.Shell.Config := { limits := l }
    let js : SafePdf.Shell.Config := { limits := l, json := true }
    let sect (name : String) (ls : Option (List String)) : List String :=
      [s!"--- {name}"] ++ ls.getD ["(none)"]
    let overlay := (List.range doc.pages.size).filterMap fun k =>
      doc.pages[k]?.map fun page =>
        [s!"--- svg overlay page {k + 1}"] ++ Svg.textOverlay l doc page
    let lines :=
      sect "text" (Text.render txt "input" r doc none true) ++
      sect "json" (Text.render js "input" r doc none false) ++
      sect "json page 1 glyphs" (Text.render js "input" r doc (some 1) true) ++
      sect "page out of range" (Text.render txt "input" r doc (some (doc.pages.size + 1)) false) ++
      overlay.flatten
    "\n".intercalate lines ++ "\n"

/-- Task 6.9: `jsonString` keeps U+2028/U+2029 (and every control character) escaped, so a
JSON object never spans two physical lines for any line splitter. -/
def jsonEscapeFailures : Nat :=
  let s := String.ofList [Char.ofNat 0x2028, Char.ofNat 0x2029, '\t', Char.ofNat 0, '"', '\\',
    Char.ofNat 0x85, Char.ofNat 0x7f, Char.ofNat 0x1f, 'x', Char.ofNat 0x20ac]
  let want := "\"\\u2028\\u2029\\t\\u0000\\\"\\\\\\u0085\\u007f\\u001fx" ++
    String.ofList [Char.ofNat 0x20ac] ++ "\""
  if SafePdf.Shell.jsonString s == want then 0 else 1

/-- Task 6.12: every encrypted variant `enc-*.pdf` renders exactly as `enc-plain.pdf`. -/
def encryptedFailures : IO Nat := do
  let plain ← IO.FS.readBinFile (dir / "enc-plain.pdf")
  let want := render plain
  let mut n := 0
  for v in ["enc-rc4-40.pdf", "enc-rc4-128.pdf", "enc-aes-128.pdf", "enc-aes-256.pdf"] do
    let got := render (← IO.FS.readBinFile (dir / v))
    if got != want then
      IO.println s!"  FAIL text view: {v} does not render as enc-plain.pdf"
      n := n + 1
  return n

/-- Directory of the encryption fixtures (`Tests/adversarial/encrypted/generate.py`). -/
def encDir : System.FilePath := "Tests" / "adversarial" / "encrypted"

/-- Fixtures of `encDir` that must not open (a non-empty user password; `/Encrypt` names a
missing object). -/
def encMustFail : List String :=
  ["userpw-aesv3.pdf", "userpw-rc4-128.pdf", "repair-lost-encrypt.pdf"]

/-- Task 6.12: the text of each fixture of `encDir` (MuPDF: `Hello, encrypted world`). -/
def adversarialFailures : IO Nat := do
  if !(← encDir.isDir) then
    IO.println s!"  FAIL text view: directory {encDir} not found"
    return 1
  let files := ((← encDir.readDir).map (·.path)).toList.filter (·.extension == some "pdf")
  let files := files.toArray.qsort (fun a b => a.toString < b.toString)
  let mut n := 0
  for f in files do
    let name := f.fileName.getD ""
    let out := render (← IO.FS.readBinFile f)
    let ok := if encMustFail.contains name then out.startsWith "error: "
      else (out.splitOn "
").contains "Hello, encrypted world" &&
        (out.splitOn "--- page 1: 22 chars, 22 glyphs, 0 U+FFFD").length == 2
    if !ok then
      IO.println s!"  FAIL text view: {encDir / name}: unexpected text"
      n := n + 1
  if files.size != 12 then
    IO.println s!"  FAIL text view: {files.size} encryption fixtures, expected 12"
    n := n + 1
  return n

/-- Task 6.8d: the page text of `actualtext.pdf` (`/ActualText` marked content) is exactly
what MuPDF 1.25.1 prints (`mutool draw -F txt`, trailing blank lines removed), and differs from
the text of the bare glyphs. -/
def actualTextMuPDF : String :=
  "Contents ...........\nTwo shows: ab end\nFewer: k\nMore: klm after\nEmpty: kept\n" ++
  "Nested: inOUTER\nNamed: Q\nLigature: fine\nPlain marked\nOpen: xyz"

/-- Task 6.8d: `actualtext.pdf` against `actualTextMuPDF`; the raw glyphs (`PageText.glyphs`)
keep the shown code's own text (C3), the shown glyphs carry the ActualText. -/
def actualTextFailures : IO Nat := do
  let bytes ← IO.FS.readBinFile (dir / "actualtext.pdf")
  let l := Limits.default
  match SafePdf.Shell.Views.Pages.docOf l (SafePdf.parseWith l bytes) with
  | .error _ =>
    IO.println "  FAIL text view: actualtext.pdf does not open"
    return 1
  | .ok doc =>
    match doc.pages[0]? with
    | none =>
      IO.println "  FAIL text view: actualtext.pdf has no page"
      return 1
    | some page =>
      match (SafePdf.Core.Text.extractDocPage l doc page (SafePdf.Core.Filter.Budget.init l)).1 with
      | .error _ =>
        IO.println "  FAIL text view: actualtext.pdf page 1 does not extract"
        return 1
      | .ok pt =>
        let raw := String.join (pt.glyphs.map (·.text))
        let mut n := 0
        if pt.text != actualTextMuPDF then
          IO.println s!"  FAIL text view: actualtext.pdf text {repr pt.text}"
          n := n + 1
        -- the bare glyphs still read "( )" for the leader and "(xy)" for the two shows
        if !((raw.splitOn "Contents ..........").length == 2 &&
            (raw.splitOn "Two shows: xy end").length == 2) then
          IO.println s!"  FAIL text view: actualtext.pdf raw glyphs {repr raw}"
          n := n + 1
        return n

/-- Run the suite; returns the number of failures. -/
def run : IO Nat := do
  let jf := jsonEscapeFailures
  if jf != 0 then IO.println "  FAIL text view: jsonString escaping of U+2028/U+2029/controls"
  let update := (← IO.getEnv Tests.Golden.updateEnvVar) == some "1"
  if !(← dir.isDir) then
    IO.println s!"  FAIL text view: directory {dir} not found (run from the repo root)"
    return 1
  let inputs := ((← dir.readDir).map (·.path)).toList.filter Tests.Golden.isInput
  let inputs := inputs.toArray.qsort (fun a b => a.toString < b.toString)
  if inputs.isEmpty then
    IO.println s!"  FAIL text view: no input files in {dir}"
    return 1
  let mut c : Tests.Golden.Counts := {}
  for input in inputs do
    c ← Tests.Golden.runCase update render input c
  if update then IO.println s!"  text view: wrote {c.written} .expected file(s)"
  else IO.println s!"  text view: {c.cases} case(s), {c.failures} failure(s)"
  let ef ← encryptedFailures
  let af ← adversarialFailures
  let atf ← actualTextFailures
  return c.failures + jf + ef + af + atf

end SafePdf.Tests.TextView
