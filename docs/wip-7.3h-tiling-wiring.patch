+/-- Most nesting levels of tiling patterns painted with the full painter (task 7.3h): a
+pattern used on the page is level 1, a pattern used in its cell level 2, …; cells of level
+`maxPatternDepth` paint the patterns they use with the path-only painter
+(`Tiling.pathPainter`), whose own patterns are mid grey. Also the number of levels loaded
+(`loadTileLevels`). -/
+def maxPatternDepth : Nat := 3
+
+/-- **The cell painter of depth `d`** (task 7.3h): a pattern cell's items are run through the
+transparency driver (`Transparency.renderTx`, as a page: soft masks, groups, blend modes)
+with the full item painter `renderItemG0`, onto the given opaque buffer through the given
+matrix (pattern space → cell buffer), with a fresh outline cache; patterns inside the cell are
+painted by the cell painter of depth `d − 1`; depth 0 is the path-only painter. Structural
+recursion on `d`: the full painter's nesting is bounded by `d`. -/
+def cellPainter (cfg : Fill.Config) (stroke : Clip.StrokeFn) (pf : PageFonts) (tt : Tiling.TileTable) :
+    Nat → Tiling.CellPainter
+  | 0 => Tiling.pathPainter cfg
+  | d + 1 => fun T w h b items =>
+    let st := (liftSh Transparency.maxMaskDepth items).foldl
+      (Transparency.renderTx (painterG0 cfg T w h stroke pf tt (cellPainter cfg stroke pf tt d)) w h
+        Transparency.maxMaskDepth) ({ rs := { buf := b } } : TState)
+    (st.rs.buf, st.rs.steps)
+
+/-- A cell painted by `cellPainter` keeps the size of its buffer (as `renderPage_size`). -/
+theorem cellPainter_size (cfg : Fill.Config) (stroke : Clip.StrokeFn) (pf : PageFonts)
+    (tt : Tiling.TileTable) (d : Nat) (T : Aff) (w h : Nat) (b : ByteArray) (items : DisplayList)
+    (hb : b.size = 4 * w * h) :
+    (cellPainter cfg stroke pf tt (d + 1) T w h b items).1.size = b.size := by
+  simp only [cellPainter]
+  rw [hb]
+  exact Transparency.renderTx_items_size _ (painterG0_lawful ..) _ _ _
+    (liftSh Transparency.maxMaskDepth items) _ (by simpa [painterG0] using hb) rfl
