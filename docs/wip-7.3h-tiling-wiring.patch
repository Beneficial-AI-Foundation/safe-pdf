+/-- How a pattern colour is painted (task 7.3h): a shading pattern with the base matrix of
+its use, or a tiling pattern with its matrix to page space (`/Matrix × base`) and the
+PaintType 2 colour. -/
+inductive PatPaint where
+  /-- A shading pattern (`PatternType 2`) and the use's base matrix. -/
+  | shade (pat : Shading.Pattern) (base : Matrix)
+  /-- A tiling pattern (`PatternType 1`), pattern space → page space, the uncoloured colour. -/
+  | tile (pat : Tiling.Tiling) (pm : Aff) (under : Color)
+
+/-- The PaintType 2 colour of a pattern use (`scn` operands, §8.7.3.3); black without
+operands. -/
+def underOf (u : Option PatternUse) : Color := (u.bind (·.under)).getD (.gray Comp.zero)
+
+/-- The loaded tiling pattern of a colour, its matrix to page space
+(`Matrix.mul patMatrix use.base`) and its PaintType 2 colour. -/
+def tileOf (tt : Tiling.TileTable) (c : Color) (u : Option PatternUse) :
+    Option (Tiling.Tiling × Aff × Color) :=
+  match Shading.patternRef c u with
+  | some (r, n, base) =>
+    (tt.get? r n).map fun t => (t, Aff.ofMatrix (Matrix.mul t.matrix base), underOf u)
+  | none => none
+
+/-- How a colour with pattern use `u` is painted: a loaded shading pattern, else a loaded
+tiling pattern, else (`none`) as a flat colour. -/
+def patPaint (pf : PageFonts) (tt : Tiling.TileTable) (c : Color) (u : Option PatternUse) :
+    Option PatPaint :=
+  match pf.shadings.patternOf c u with
+  | some (p, b) => some (.shade p b)
+  | none => (tileOf tt c u).map fun (t, pm, uc) => .tile t pm uc
+
